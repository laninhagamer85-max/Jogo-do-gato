+import { describe, expect, it, vi } from 'vitest';
+import { EXPLORATION_ROOM_COUNT } from './explorationNascentesLayout';
+import { roomVillagers } from './explorationVillageLayout';
+import { readVillage, villageSnapshot } from './explorationVillage';
+import { readVillageOrder, type VillageIncident } from './explorationVillageOrder';
+
+const NOW = 1_800_000_000_000;
+function incident(room: number): VillageIncident {
+  const defs = roomVillagers(room);
+  const guard = defs.find(d => d.kind === 'guard')!;
+  const offender = defs.find(d => d.settlement === guard.settlement && d.kind !== 'guard' && d.kind !== 'child')!;
+  expect(guard).toBeDefined();
+  expect(offender).toBeDefined();
+  return { room, settlement: guard.settlement, offenders: [offender.id], guard: guard.id,
+    phase: 'detained', started: NOW - 10_000, until: NOW + 30_000 };
+}
+
+describe('village order save boundaries', () => {
+  it.each(Array.from({ length: EXPLORATION_ROOM_COUNT }, (_, room) => room))(
+    'preserves a valid detention in room index %i without restarting its timer', room => {
+      const entry = incident(room);
+      const raw = { nextAt: NOW + 100_000, incidents: { [room]: entry } };
+      const loaded = readVillageOrder(JSON.parse(JSON.stringify(raw)), NOW);
+      expect(loaded.incidents[String(room)]).toEqual(entry);
+      expect(loaded.incidents[String(room)]?.offenders).not.toBe(entry.offenders);
+      expect(readVillageOrder(raw, entry.until).incidents).toEqual({});
+      expect(raw.incidents[room]).toEqual(entry);
+    },
+  );
+
+  it('retains room 40 through the actual village snapshot/restore path', () => {
+    vi.useFakeTimers();
+    try {
+      vi.setSystemTime(NOW);
+      const entry = incident(39);
+      const loaded = readVillage({ order: { nextAt: NOW + 100_000, incidents: { 39: entry } } });
+      const restored = readVillage(JSON.parse(JSON.stringify(villageSnapshot(loaded))));
+      expect(restored.order?.incidents['39']).toEqual(entry);
+    } finally { vi.useRealTimers(); }
+  });
+
+  it.each([-1, EXPLORATION_ROOM_COUNT, 1.5, '39', null, Number.NaN, Number.POSITIVE_INFINITY])(
+    'rejects an invalid or future room identifier %s', room => {
+      const raw = { ...incident(39), room };
+      expect(readVillageOrder({ incidents: { x: raw } }, NOW).incidents).toEqual({});
+    },
+  );
+
+  it('still rejects a guard or offender from a different room', () => {
+    const entry = incident(39), other = incident(30);
+    for (const invalid of [{ ...entry, guard: other.guard }, { ...entry, offenders: other.offenders }]) {
+      expect(readVillageOrder({ incidents: { 39: invalid } }, NOW).incidents).toEqual({});
+    }
+  });
+});
