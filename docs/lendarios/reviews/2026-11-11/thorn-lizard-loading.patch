 /** A destination keeps its image through progress updates, retries and portal handoff. */
 export function createLoadingSceneSelector(random= Math.random){let key='boot',current:typeof LOADING_SCENES[number]=LOADING_SCENES[0];return (destination:string)=>{if(destination===key)return current;const choices=LOADING_SCENES.filter(scene=>scene.id!==current.id);current=choices[Math.max(0,Math.min(choices.length-1,Math.floor(random()*choices.length)))];key=destination;return current;};}
